# XMTP Referral Bot Configuration
# Copy to .env and fill in values

# Bot's ECDSA private key (0x-prefixed hex)
XMTP_BOT_KEY=

# On-chain registry address (proxy)
REGISTRY_ADDRESS=

# RPC URL for reading on-chain state
RPC_URL=https://sepolia.base.org

# XMTP environment: "production" or "dev"
XMTP_ENV=dev
