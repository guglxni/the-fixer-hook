# FixerHook MCP Server — Environment Variables
# For Claude Desktop / local use, pass these via the mcpServers env block.
# For server/SSE deployment, copy to .env.

# Transport: "stdio" (default, for Claude Desktop) or "http" (for server deployment)
MCP_TRANSPORT=stdio

# HTTP port — only used when MCP_TRANSPORT=http
MCP_PORT=3403

# Base mainnet RPC
RPC_URL=https://mainnet.base.org

# FixerRegistryUpgradeable proxy address
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
