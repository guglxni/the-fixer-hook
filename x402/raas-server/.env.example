# FixerHook RaaS Server Environment Variables

# === Server ===
PORT=3402
NODE_ENV=development

# === x402 Configuration ===
# Treasury address to receive x402 payments
X402_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
# USDC contract address on Base
X402_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# x402 Facilitator URL (Coinbase CDP by default)
X402_FACILITATOR_URL=https://x402.org/facilitator

# === On-Chain (read-only) ===
# Base mainnet RPC URL
RPC_URL=https://mainnet.base.org
# FixerRegistryUpgradeable proxy address
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Private key for admin operations (registerAgent, etc.)
# NEVER commit this — use .env only
ADMIN_PRIVATE_KEY=
