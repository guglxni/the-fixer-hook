%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui, sans-serif'}}}%%
flowchart TB
    subgraph USER["User"]
        U1["Initiate swap with hookData<br/>(encoded referrer address)"]
    end

    subgraph SWAP["Swap Execution"]
        S1["SwapRouter"]
        S2["PoolManager"]
        S3["FixerHook afterSwap callback"]
    end

    subgraph VALIDATION["Referral Validation"]
        V1{"hookData<br/>present?"}
        V2["Decode referrer address"]
        V3{"referrer != <br/>address(0)?"}
        V4{"referrer != <br/>tx.origin?"}
    end

    subgraph REWARD["Reward Distribution"]
        R1["Calculate reward amount"]
        R2["Mint FIX tokens to referrer"]
    end

    SKIP["Skip -- return selector"]

    U1 --> S1
    S1 --> S2
    S2 --> S3
    S3 --> V1
    V1 -->|No| SKIP
    V1 -->|Yes| V2
    V2 --> V3
    V3 -->|No| SKIP
    V3 -->|Yes| V4
    V4 -->|No| SKIP
    V4 -->|Yes| R1
    R1 --> R2
    R2 --> END1["Swap complete with reward"]
    SKIP --> END2["Swap complete, no reward"]

    style USER fill:#f8fafc,stroke:#94a3b8,color:#1e293b
    style SWAP fill:#f1f5f9,stroke:#94a3b8,color:#1e293b
    style VALIDATION fill:#f1f5f9,stroke:#94a3b8,color:#1e293b
    style REWARD fill:#f1f5f9,stroke:#94a3b8,color:#1e293b
    style SKIP fill:#e2e8f0,color:#1e293b,stroke:#64748b
    style END1 fill:#1e293b,color:#f8fafc,stroke:#0f172a
    style END2 fill:#e2e8f0,color:#1e293b,stroke:#64748b
