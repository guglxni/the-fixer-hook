%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui, sans-serif'}}}%%
flowchart TD
    Swap["Swap executed"] --> Compute["computeReward()"]
    Compute --> Base["baseReward = swapAmount x rewardRateBps / 10000"]
    Base --> Fee["_applyProtocolFee()"]
    Fee --> CalcFee["protocolFee = baseReward x 500 / 10000 (5%)"]
    CalcFee --> Net["netReward = baseReward - protocolFee"]
    CalcFee --> Accum["accumulatedFees += protocolFee"]
    Accum --> Dist["distributeFees()<br/>(callable by anyone)"]
    Dist --> Treasury["Treasury (50%)"]
    Dist --> Buyback["Buyback Contract (30%)"]
    Dist --> Stakers["Staker Rewards (20%)"]

    style Swap fill:#1e293b,color:#f8fafc,stroke:#0f172a
    style Treasury fill:#e2e8f0,color:#1e293b,stroke:#64748b
    style Buyback fill:#e2e8f0,color:#1e293b,stroke:#64748b
    style Stakers fill:#e2e8f0,color:#1e293b,stroke:#64748b
