%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui, sans-serif'}}}%%
flowchart TD
    START(["Swap Initiated"]) --> HOOKDATA{"hookData<br/>exists?"}

    HOOKDATA -->|No| SKIP["Skip processing"]
    HOOKDATA -->|Yes| DECODE["Decode referrer address"]

    DECODE --> VALID1{"referrer !=<br/>address(0)?"}
    VALID1 -->|No| SKIP
    VALID1 -->|Yes| VALID2{"Not<br/>self-referral?"}

    VALID2 -->|No| SKIP
    VALID2 -->|Yes| CALC["Calculate base reward"]

    CALC --> MAXCHECK{"Exceeds<br/>max reward?"}
    MAXCHECK -->|Yes| CAP["Cap at MAX_REWARD"]
    MAXCHECK -->|No| MINCHECK{"Below<br/>min reward?"}

    CAP --> MINT
    MINCHECK -->|Yes| FLOOR["Set to MIN_REWARD"]
    MINCHECK -->|No| MINT

    FLOOR --> MINT["Mint FIX tokens"]
    MINT --> UPDATE["Update referrer stats"]
    UPDATE --> RETURN2["Return selector"]

    SKIP --> RETURN1["Return selector"]

    RETURN1 --> DONE(["Swap Complete"])
    RETURN2 --> DONE

    style START fill:#1e293b,color:#f8fafc,stroke:#0f172a
    style DONE fill:#1e293b,color:#f8fafc,stroke:#0f172a
    style SKIP fill:#e2e8f0,color:#1e293b,stroke:#64748b
    style CAP fill:#e2e8f0,color:#1e293b,stroke:#64748b
    style FLOOR fill:#e2e8f0,color:#1e293b,stroke:#64748b
