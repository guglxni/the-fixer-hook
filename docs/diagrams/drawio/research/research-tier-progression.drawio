        <mxCell id="note1" value="&lt;b&gt;Key Properties:&lt;/b&gt;  Tiers are monotonically increasing (never demoted). Checked automatically on every recordReferral() call." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="80" y="618" width="800" height="18" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Threshold Type:&lt;/b&gt;  Dual-gate (AND logic). Both volume AND referral count must exceed thresholds simultaneously." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="80" y="638" width="800" height="18" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="&lt;b&gt;Configurability:&lt;/b&gt;  Thresholds are owner-adjustable via setTierThresholds(). Max multiplier capped at 10x (100,000 bps)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="80" y="658" width="800" height="18" as="geometry" />
        </mxCell>

