        <mxCell id="phase3-label" value="Phase 3: Stats Update, Circuit Breaker, Mint, and Event Emission" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#BE185D;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="75" y="548" width="450" height="18" as="geometry" />
        </mxCell>

        <!-- Step 10: Update stats -->
        <mxCell id="s10" value="&lt;b&gt;Update&lt;br&gt;Stats&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#9F1239;strokeColor=#881337;strokeWidth=1.5;fontSize=13;fontColor=#FFF1F2;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="80" y="590" width="120" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s10-detail" value="&lt;font style=&quot;font-size:9px;&quot;&gt;referrerStats: volume, count, earned&lt;br&gt;poolInfos: totalReferrals, totalVolume&lt;br&gt;globalCounters: totalReferrals, totalVolume&lt;br&gt;&lt;b&gt;Gas: ~20,000+ (multiple SSTOREs)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#9F1239;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="45" y="650" width="195" height="64" as="geometry" />
        </mxCell>

        <!-- Step 11: Tier upgrade check -->
        <mxCell id="s11" value="&lt;b&gt;Tier&lt;br&gt;Upgrade?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#9F1239;strokeColor=#881337;strokeWidth=1.5;fontSize=13;fontColor=#FFF1F2;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="290" y="590" width="120" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s11-detail" value="&lt;font style=&quot;font-size:9px;&quot;&gt;_calculateTier(volume, refCount)&lt;br&gt;if newTier &gt; currentTier: upgrade&lt;br&gt;emit TierUpgrade if changed&lt;br&gt;&lt;b&gt;Gas: ~6,400 (3x SLOAD + cmp)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#9F1239;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="260" y="650" width="185" height="64" as="geometry" />
        </mxCell>

        <!-- Step 12: Circuit breaker -->
        <mxCell id="s12" value="&lt;b&gt;Circuit&lt;br&gt;Breaker&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#9F1239;strokeColor=#881337;strokeWidth=1.5;fontSize=13;fontColor=#FFF1F2;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="500" y="590" width="120" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s12-detail" value="&lt;font style=&quot;font-size:9px;&quot;&gt;_checkCircuitBreaker(reward)&lt;br&gt;Hourly: 1M FIX/hr threshold&lt;br&gt;Daily: 10M FIX/day ceiling&lt;br&gt;Auto-pauses rewards if exceeded&lt;br&gt;&lt;b&gt;Gas: ~5,300 (SLOADs + SSTOREs)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#9F1239;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="465" y="650" width="195" height="72" as="geometry" />
        </mxCell>

        <!-- Step 13: Mint -->
        <mxCell id="s13" value="&lt;b&gt;_mint()&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#9F1239;strokeColor=#881337;strokeWidth=1.5;fontSize=13;fontColor=#FFF1F2;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="710" y="590" width="120" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s13-detail" value="&lt;font style=&quot;font-size:9px;&quot;&gt;_mint(referrer, netReward)&lt;br&gt;MAX_SUPPLY check (1B FIX cap)&lt;br&gt;ERC20Upgradeable._update()&lt;br&gt;&lt;b&gt;Gas: ~26,000 (SSTORE x2)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#9F1239;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="680" y="650" width="185" height="64" as="geometry" />
