          <mxGeometry x="920" y="590" width="120" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s14-detail" value="&lt;font style=&quot;font-size:9px;&quot;&gt;emit CrossPoolReferral(referrer,&lt;br&gt;  swapper, poolId, volume, reward)&lt;br&gt;emit ReferralProcessed (hook)&lt;br&gt;&lt;b&gt;Gas: ~3,800 (LOG4)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#9F1239;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="885" y="650" width="195" height="64" as="geometry" />
        </mxCell>

        <!-- Return -->
        <mxCell id="s15" value="&lt;b&gt;Return&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;(selector, 0)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#166534;strokeColor=#14532D;strokeWidth=1.5;fontSize=13;fontColor=#F0FDF4;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1130" y="590" width="120" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s15-detail" value="&lt;font style=&quot;font-size:9px;&quot;&gt;Back to PoolManager&lt;br&gt;int128(0): no delta mod&lt;br&gt;Swap output unchanged&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=#166534;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1105" y="650" width="170" height="46" as="geometry" />
