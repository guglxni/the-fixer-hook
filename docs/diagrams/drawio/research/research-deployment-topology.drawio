        <mxCell id="n1" value="&lt;b&gt;Per-Chain Registry:&lt;/b&gt; Each chain has its own FixerRegistryUpgradeable proxy with independent FIX token supply, tier tracking, and stats." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="80" y="645" width="800" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Per-Pool Hook:&lt;/b&gt; Each hook instance is bound to exactly one PoolManager + PoolKey. Multiple pools per chain require separate hook deployments." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="80" y="665" width="900" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Shared Configuration:&lt;/b&gt; Same deployer (0xDDe9...682e), same fee/tickSpacing (30bps/60), same VERSION (2.4.0) across all chains." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="80" y="685" width="900" height="18" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;No Cross-Chain Messaging:&lt;/b&gt; v2.4 does not bridge state. Cross-chain aggregation planned for v3.0 via Hyperlane/CCIP." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="80" y="705" width="900" height="18" as="geometry" />
        </mxCell>

        <!-- Contract count summary -->
        <mxCell id="count-box" value="&lt;b&gt;Total Contracts per Chain:&lt;/b&gt; 4 (1 Hook + 1 Proxy + 1 Implementation + 1 Credential)&lt;br&gt;&lt;b&gt;Total Testnet Deployments:&lt;/b&gt; 12 contracts across 3 chains" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1000" y="650" width="480" height="36" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
