        </mxCell>
        <mxCell id="subtitle" value="Observation-only side-effect pattern: swap execution is unmodified; referral rewards are a post-swap side effect" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#64748B;fontFamily=Inter,system-ui,sans-serif;" vertex="1" parent="1">
