%%{init: {'theme': 'neutral', 'themeVariables': {'fontFamily': 'Inter, system-ui, sans-serif'}}}%%
flowchart TD
    subgraph storage["ERC-7201 Namespaced Storage Layout"]
        direction TB
        subgraph packed1["Slot Group 1: Reward Parameters"]
            P1["uint128 minSwapAmount<br/>uint64 rewardRateBps<br/>uint64 __reserved1"]
        end
        subgraph packed2["Slot Group 2: Reward Bounds"]
            P2["uint128 maxRewardAmount<br/>uint128 minRewardAmount"]
        end
        subgraph packed3["Slot Group 3: Protocol Fee"]
            P3["uint64 protocolFeeBps (500 = 5%)<br/>uint64 maxProtocolFeeBps (1000 = 10%)<br/>uint128 accumulatedFees"]
        end
        subgraph packed4["Slot Group 4: Tier Thresholds"]
            P4["uint64 silverThreshold<br/>uint64 goldThreshold<br/>uint128 platinumThreshold"]
        end
        subgraph maps["Mappings"]
            M1["authorizedHooks, poolInfos, referrerStats"]
            M2["agentRegistry (v2.2), referrerTeams (v2.6)"]
            M3["agentEndorsements (v2.7), agentRatings (v2.7)"]
            M4["teamMembers (v2.6), crossChainStats (v2.3)"]
        end
        subgraph emergency["Emergency State"]
            E1["bool pausedReferrals, pausedAgents, pausedRewards"]
            E2["uint256 pausedAt, circuitBreakerThreshold"]
            E3["uint256 mintedThisHour, hourStartedAt"]
            E4["address securityCouncil, governance"]
        end
        subgraph fees["Fee Addresses"]
            F1["address treasury (50%)<br/>address buybackContract (30%)<br/>address stakerRewards (20%)"]
        end
        GAP["uint256[50] __gap -- reserved for upgrades"]
    end

    style storage fill:#f8fafc,stroke:#94a3b8,color:#1e293b
