flowchart TD
    Start{"hookData.length > 0?"} -->|Yes| Decode["referrer = decode(hookData)"]
    Decode --> Check2{"referrer !=<br/>address(0)?"}
    Check2 -->|Yes| Check3{"referrer !=<br/>tx.origin?"}
    Check3 -->|Yes| Mint["_mint(referrer, REWARD_AMOUNT)"]
    Mint --> Result(["FIX tokens minted to referrer"])

    Start -->|No| Skip
    Check2 -->|No| Skip
    Check3 -->|No| Skip
    Skip["Skip -- return selector"] --> Done(["Swap completes normally"])

    style Start fill:#e2e8f0,color:#1e293b,stroke:#64748b
    style Result fill:#1e293b,color:#f8fafc,stroke:#0f172a
    style Done fill:#e2e8f0,color:#1e293b,stroke:#64748b
    style Skip fill:#e2e8f0,color:#1e293b,stroke:#64748b
