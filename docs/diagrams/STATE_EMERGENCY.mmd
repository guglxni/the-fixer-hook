stateDiagram-v2
    [*] --> Normal : Initialization

    Normal --> Paused : pauseReferrals()
    Normal --> Paused : pauseAgents()
    Normal --> Paused : pauseRewards()
    Normal --> Paused : pauseAll()
    Normal --> CircuitBreaker : minted > threshold

    CircuitBreaker --> Paused : Auto-trigger

    Paused --> Normal : resume() within 7 days
    Paused --> DAOLock : 7 days elapsed

    DAOLock --> Normal : DAO governance resume()
    DAOLock --> Normal : executeUpgrade()

    state Normal {
        [*] --> Active
        Active : All operations permitted
        Active : Circuit breaker monitors hourly minting
    }

    state Paused {
        [*] --> Restricted
        Restricted : Affected operations revert
        Restricted : Other operations continue
        Restricted : Security council can resume
    }

    state DAOLock {
        [*] --> Locked
        Locked : Security council cannot resume
        Locked : Only DAO governance can act
    }

    state CircuitBreaker {
        [*] --> Triggered
        Triggered : Hourly mint threshold exceeded
        Triggered : Automatically pauses rewards
        Triggered : Manual resume required
    }
