stateDiagram-v2
    [*] --> NORMAL: Initialization
    NORMAL --> PAUSED: pauseReferrals()
    NORMAL --> PAUSED: pauseAgents()
    NORMAL --> PAUSED: pauseRewards()
    NORMAL --> PAUSED: pauseAll()
    NORMAL --> CIRCUIT_BREAKER: minted > threshold
    CIRCUIT_BREAKER --> PAUSED: Auto-trigger
    PAUSED --> NORMAL: resume() < 7 days
    PAUSED --> DAO_LOCK: 7 days elapsed
    DAO_LOCK --> NORMAL: DAO governance resume()
    DAO_LOCK --> NORMAL: executeUpgrade()
    
    state NORMAL {
        [*] --> ACTIVE
        ACTIVE --> ACTIVE: All operations permitted
    }
    
    state PAUSED {
        [*] --> REFERRALS_OFF
        REFERRALS_OFF: Referrals paused
        REFERRALS_OFF --> REFERRALS_OFF: continue paused
        REFERRALS_OFF --> ACTIVE: resumeReferrals()
    }
    
    state DAO_LOCK {
        [*] --> SECURE_LOCKED
        SECURE_LOCKED: Security council
        SECURE_LOCKED: CANNOT resume
        SECURE_LOCKED --> SECURE_LOCKED: Only DAO can
    }
    
    state CIRCUIT_BREAKER {
        [*] --> TRIGGERED
        TRIGGERED: Hourly threshold
        TRIGGERED: exceeded
        TRIGGERED --> TRIGGERED: Manual resume required
    }
    
    style NORMAL fill:#dcfce7,stroke:#22c55e
    style PAUSED fill:#fef3c7,stroke:#f59e0b
    style DAO_LOCK fill:#fee2e2,stroke:#ef4444
    style CIRCUIT_BREAKER fill:#fee2e2,stroke:#ef4444
