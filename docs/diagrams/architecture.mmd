flowchart TB
    subgraph USER["User / Frontend"]
        U1["DApp Interface"]
        U2["Encode referrer in hookData"]
    end

    subgraph ROUTER["Router Layer"]
        R1["SwapRouter"]
        R2["Encode hookData"]
    end

    subgraph POOL["Uniswap v4 Core"]
        P1["PoolManager"]
        P2["Pool State"]
    end

    subgraph HOOK["FixerHook"]
        H1["afterSwap() callback"]
        H2["Validate referrer"]
        H3["Calculate reward"]
        H4["Mint FIX tokens"]
    end

    subgraph REGISTRY["FixerRegistry (v2)"]
        RC1["Record referral"]
        RC2["Track volume"]
        RC3["Update tier"]
    end

    U1 --> U2
    U2 --> R1
    R1 --> P1
    P1 --> H1
    H1 --> H2
    H2 --> H3
    H3 --> H4
    H4 --> RC1
    RC1 --> RC2
    RC2 --> RC3

